#!/usr/bin/env bash
set -euo pipefail

# Cache directory and state file paths
# Konfiguracja ścieżek i plików cache
CACHE_DIR="/tmp/blackwell_egpu"
STATE_FILE="$CACHE_DIR/mode"
WAIT_FILE="$CACHE_DIR/wait"
IGPU_FILE="$CACHE_DIR/igpu_name"
IGPU2_FILE="$CACHE_DIR/igpu2_name"
EGPU_FILE="$CACHE_DIR/egpu_name"
EGPU2_FILE="$CACHE_DIR/egpu2_name"
LINK_FILE="$CACHE_DIR/pcie_link"
EGPU_ONLY_FILE="$CACHE_DIR/egpu_only"
IGPU_PARENT_FILE="$CACHE_DIR/igpu_parent_bridge"
TRAFFIC_CACHE="$CACHE_DIR/traffic"

ACTION="${1:-status}"
TARGET_MODE="${2:-}"

# ==============================================================================
# 1. INITIALIZATION (Executed ONLY on the first run)
# 1. INICJALIZACJA (Wykonywana WYŁĄCZNIE przy pierwszym uruchomieniu)
# ==============================================================================
if [ ! -d "$CACHE_DIR" ]; then
    mkdir -p "$CACHE_DIR"
    echo "0" > "$WAIT_FILE"

    # Detect and save base iGPU name from lspci
    # Wykrycie i zapis nazwy bazowej iGPU z lspci
    IGPU_NAME=$(lspci 2>/dev/null | grep -iE "VGA|3D" | grep -iE "intel|amd|advanced micro devices" | head -n1 | cut -d ':' -f3 | xargs || true)
    echo "${IGPU_NAME:-Integrated Graphics}" > "$IGPU_FILE"

    # Detect clean iGPU rendering device name via glxinfo
    # Wykrycie czytelnej nazwy iGPU przez glxinfo
    IGPU_NAME2=$(glxinfo -B 2>/dev/null | grep -m1 "Device:" | cut -d: -f2- | sed 's/ (.*//' | xargs || true)
    echo "${IGPU_NAME2:-Integrated GPU}" > "$IGPU2_FILE"

    # Verify initial Thunderbolt/USB4 connection status via boltctl
    # Weryfikacja stanu początkowego przez boltctl
    BOLT_INFO=$(boltctl list 2>/dev/null || true)

    if echo "$BOLT_INFO" | grep -Eq 'status:[[:space:]]+authorized$'; then
        EGPU_NAME=$(echo "$BOLT_INFO" | grep -m1 "name:" | cut -d ':' -f2 | xargs || true)
        echo "${EGPU_NAME:-eGPU Device}" > "$EGPU_FILE"

        EGPU_MODEL=$(echo "$BOLT_INFO" | grep -m1 "name:" | cut -d ':' -f2 | xargs || true)
        echo "${EGPU_MODEL:-NVIDIA Graphics}" > "$EGPU2_FILE"

        echo "2" > "$STATE_FILE"
    elif echo "$BOLT_INFO" | grep -Eq 'status:[[:space:]]+connected$'; then
        EGPU_NAME=$(echo "$BOLT_INFO" | grep -m1 "name:" | cut -d ':' -f2 | xargs || true)
        echo "${EGPU_NAME:-eGPU Device}" > "$EGPU_FILE"
        echo "1" > "$STATE_FILE"
    else
        echo "0" > "$STATE_FILE"
    fi
fi

# ==============================================================================
# 2. FAST SYSFS CONNECTION VERIFICATION (Zero-Fork / Polling)
# 2. SZYBKA WERYFIKACJA POŁĄCZENIA W SYSFS (Zero-Fork / Polling)
# ==============================================================================
# Detect Thunderbolt/USB4 child devices (exclude built-in root switches ending with -0)
# Wykrywanie urządzeń podrzędnych Thunderbolt/USB4 (wykluczenie wbudowanych root switchy kończących się na -0)

# If eGPU-only flag is set, lock mode to 4 and wait to 0
# Jeśli flaga eGPU-only istnieje, wymuś mode 4 i wait 0
if [ -f "$EGPU_ONLY_FILE" ]; then
    echo "4" > "$STATE_FILE"
    echo "0" > "$WAIT_FILE"
fi

TB_DEVICE=$(ls -d /sys/bus/thunderbolt/devices/*-* 2>/dev/null | grep -vE -- '-0$' | head -n1 || true)

if [ -z "$TB_DEVICE" ]; then
    echo "0" > "$STATE_FILE"
    echo "0" > "$WAIT_FILE"
    rm -f "$EGPU_FILE" "$EGPU2_FILE" "$LINK_FILE" "$EGPU_ONLY_FILE" "$TRAFFIC_CACHE"

    if [ "$ACTION" = "status" ]; then
        IGPU_NAME=$(cat "$IGPU_FILE" 2>/dev/null | tr -d '"' || echo "Integrated Graphics")
        IGPU_NAME2=$(cat "$IGPU2_FILE" 2>/dev/null | tr -d '"' || echo "Integrated GPU")
        printf '{"mode":0,"wait":0,"igpu":"%s","igpu2":"%s","egpu":"None","egpu2":"None","link":"N/A"}\n' "$IGPU_NAME" "$IGPU_NAME2"
    fi
    exit 0
else
    # If state in memory is 0 and device is physically connected (Hot-Plug)
    # Jeśli stan w pamięci to 0, a urządzenie zostało fizycznie podpięte (Hot-Plug)
    CURRENT_STATE=$(cat "$STATE_FILE" 2>/dev/null || echo "0")
    if [ "$CURRENT_STATE" = "0" ]; then
        if [ -f "$TB_DEVICE/authorized" ] && [ "$(<"$TB_DEVICE/authorized")" = "1" ]; then
            echo "2" > "$STATE_FILE"
        else
            echo "1" > "$STATE_FILE"
        fi

        if [ -f "$TB_DEVICE/device_name" ]; then
            cat "$TB_DEVICE/device_name" > "$EGPU_FILE"
        fi
    fi
fi

# ==============================================================================
# 3. STATUS COMMAND HANDLER (Queried by the applet every 2-3 seconds)
# 3. OBSŁUGA POLECENIA STATUS (Dla apletu co 2 sekundy)
# ==============================================================================
if [ "$ACTION" = "status" ]; then
    CURRENT_MODE=$(cat "$STATE_FILE" 2>/dev/null || echo "1")
    IS_WAITING=$(cat "$WAIT_FILE" 2>/dev/null || echo "0")
    IGPU_NAME=$(cat "$IGPU_FILE" 2>/dev/null | tr -d '"' || echo "Integrated Graphics")
    IGPU_NAME2=$(cat "$IGPU2_FILE" 2>/dev/null | tr -d '"' || echo "Integrated GPU")
    EGPU_NAME=$(cat "$EGPU_FILE" 2>/dev/null | tr -d '"' || echo "eGPU Device")
    EGPU_NAME2=$(cat "$EGPU2_FILE" 2>/dev/null | tr -d '"' || echo "NVIDIA Graphics")
    PCIE_LINK=$(cat "$LINK_FILE" 2>/dev/null || echo "N/A")

    GPU_UTIL=0
    PWR_CURR=0
    VRAM_USED=0
    VRAM_TOTAL=0
    GPU_TEMP=0
    PCIE_RX=0
    PCIE_TX=0

    if [ "$CURRENT_MODE" -ge 3 ]; then
        TELEMETRY=$(nvidia-smi --query-gpu=utilization.gpu,power.draw,memory.used,memory.total,temperature.gpu --format=csv,noheader,nounits 2>/dev/null || echo "0, 0, 0, 0, 0")
        IFS=',' read -r GPU_UTIL PWR_CURR VRAM_USED VRAM_TOTAL GPU_TEMP <<< "$TELEMETRY"

        GPU_UTIL="${GPU_UTIL// /}"
        PWR_CURR="${PWR_CURR// /}"
        VRAM_USED="${VRAM_USED// /}"
        VRAM_TOTAL="${VRAM_TOTAL// /}"
        GPU_TEMP="${GPU_TEMP// /}"

        # Błyskawiczny odczyt zapisanego w cache transferu PCIe RX/TX (0ms opóźnienia)
        if [ -f "$TRAFFIC_CACHE" ]; then
            read -r PCIE_RX PCIE_TX < "$TRAFFIC_CACHE" 2>/dev/null || { PCIE_RX=0; PCIE_TX=0; }
        fi
    fi

    printf '{"mode":%s,"wait":%s,"igpu":"%s","igpu2":"%s","egpu":"%s","egpu2":"%s","link":"%s","gpu_util":%s,"pwr_curr":%s,"vram_used":%s,"vram_total":%s,"temp":%s,"pcie_rx":%s,"pcie_tx":%s}\n' \
        "$CURRENT_MODE" "$IS_WAITING" "$IGPU_NAME" "$IGPU_NAME2" "$EGPU_NAME" "$EGPU_NAME2" "$PCIE_LINK" \
        "${GPU_UTIL:-0}" "${PWR_CURR:-0}" "${VRAM_USED:-0}" "${VRAM_TOTAL:-0}" "${GPU_TEMP:-0}" \
        "${PCIE_RX:-0}" "${PCIE_TX:-0}"

    # Asynchroniczny pomiar PCIe dmon w tle na poczet kolejnego cyklu
    if [ "$CURRENT_MODE" -ge 3 ]; then
        (
            NEW_METRICS=$(nvidia-smi dmon -s t -c 1 -d 2 2>/dev/null | awk 'NR>2 {print $2, $3}')
            if [ -n "$NEW_METRICS" ]; then
                echo "$NEW_METRICS" > "$TRAFFIC_CACHE.tmp" && mv -f "$TRAFFIC_CACHE.tmp" "$TRAFFIC_CACHE"
            fi
        ) &>/dev/null &
    fi

    exit 0
fi

# ==============================================================================
# 4. BUS RETRAINING & LINK SPEED NEGOTIATION HELPERS
# 4. FUNKCJE POMOCNICZE NEGOCJACJI MAGISTRALI
# ==============================================================================
negotiate_optimal_link_speed() {
    local GPU_PCI="$1"
    local PARENT_PORT="$2"

    local gpu_speed parent_speed
    gpu_speed=$(lspci -s "$GPU_PCI" -vv 2>/dev/null | awk '/LnkCap:/ {for(i=1;i<=NF;i++) if($i ~ /Speed/) print $(i+1)}' | tr -dc '0-9' || true)
    parent_speed=$(lspci -s "$PARENT_PORT" -vv 2>/dev/null | awk '/LnkCap:/ {for(i=1;i<=NF;i++) if($i ~ /Speed/) print $(i+1)}' | tr -dc '0-9' || true)

    local min_speed=${gpu_speed:-16}
    if [ -n "$parent_speed" ] && [ "$parent_speed" -lt "$min_speed" ]; then
        min_speed=$parent_speed
    fi

    case "$min_speed" in
        32*) echo "0025" ;; # Gen5
        16*) echo "0024" ;; # Gen4
        8*)  echo "0023" ;; # Gen3
        *)   echo "0024" ;; # Safe default / Bezpieczny standard
    esac
}

# ==============================================================================
# 5. MODE EXECUTION FUNCTIONS (SET)
# 5. FUNKCJE WYKONAWCZE TRYBÓW (SET)
# ==============================================================================
set2() {
    # Mode 2: Authorize eGPU via boltctl and save device name
    # Mode 2: Autoryzacja eGPU przez boltctl i zapis nazwy
    local DEV_UUID
    DEV_UUID=$(boltctl list 2>/dev/null | grep -B5 -E 'status:[[:space:]]+connected$' | grep -m1 "uuid:" | cut -d ':' -f2 | xargs || true)

    if [ -n "$DEV_UUID" ]; then
        boltctl enroll "$DEV_UUID" >/dev/null 2>&1 || true
    fi

    local BOLT_INFO
    BOLT_INFO=$(boltctl list 2>/dev/null || true)
    if echo "$BOLT_INFO" | grep -Eq 'status:[[:space:]]+authorized$'; then
        local EGPU_NAME
        EGPU_NAME=$(echo "$BOLT_INFO" | grep -m1 "name:" | cut -d ':' -f2 | xargs || true)
        echo "${EGPU_NAME:-eGPU Device}" > "$EGPU_FILE"
    fi

    echo "2"
}

set3() {
    # Mode 3: Hybrid mode (iGPU + eGPU / load NVIDIA modules, PCIe retraining)
    # Mode 3: Tryb hybrydowy (iGPU + eGPU / moduły nvidia, retraining PCIe)
    if ! lsmod | grep -q "^nvidia "; then
        fuser -k /dev/nvidia* >/dev/null 2>&1 || true
        modprobe -r nvidia_uvm nvidia_drm nvidia_modeset nvidia >/dev/null 2>&1 || true

        if command -v boltctl >/dev/null 2>&1; then
            local PENDING_UUIDS
            PENDING_UUIDS=$(boltctl list 2>/dev/null | awk '/ ● / {uuid=$2} /status:[[:space:]]+(connected|authorizing)/ {print uuid}' || true)
            for uuid in $PENDING_UUIDS; do
                boltctl enroll --policy auto "$uuid" >/dev/null 2>&1 || boltctl authorize "$uuid" >/dev/null 2>&1 || true
            done
        fi

        touch /tmp/egpu_allow
        echo 1 > /sys/bus/pci/rescan 2>/dev/null || true
        udevadm settle --timeout=2 2>/dev/null || true
        rm -f /tmp/egpu_allow

        # Czekaj do 2 sekund na pojawienie się karty na magistrali PCI
        local GPU_FULL_PCI=""
        local retries=0
        while [ $retries -lt 20 ]; do
            GPU_FULL_PCI=$(lspci -D -d 10de: -nn 2>/dev/null | grep -iE "VGA|3D" | awk '{print $1}' | head -n 1 || true)
            if [ -n "$GPU_FULL_PCI" ]; then
                break
            fi
            sleep 0.1
            retries=$((retries + 1))
        done

        if [ -z "$GPU_FULL_PCI" ]; then
            echo "2"
            return 0
        fi

        local PCI_TREE BRIDGE_LIST TOTAL_NODES PARENT_PORT TARGET_HEX
        PCI_TREE=$(lspci -D -PP -s "$GPU_FULL_PCI" 2>/dev/null | awk '{print $1}' || true)
        IFS="/" read -ra BRIDGE_LIST <<< "$PCI_TREE"
        TOTAL_NODES=${#BRIDGE_LIST[@]}

        echo performance > /sys/module/pcie_aspm/parameters/policy 2>/dev/null || true

        for node in "${BRIDGE_LIST[@]}"; do
            setpci -s "$node" CAP_EXP+10.w=0000 >/dev/null 2>&1 || true
            setpci -s "$node" ECAP_1E+04.l=00000000 >/dev/null 2>&1 || true
        done

        if [ "$TOTAL_NODES" -ge 2 ]; then
            PARENT_PORT="${BRIDGE_LIST[$((TOTAL_NODES - 2))]}"
            TARGET_HEX=$(negotiate_optimal_link_speed "$GPU_FULL_PCI" "$PARENT_PORT")

            setpci -s "$PARENT_PORT" CAP_EXP+30.w="$TARGET_HEX:002f" >/dev/null 2>&1 || true
            setpci -s "$GPU_FULL_PCI" CAP_EXP+30.w="$TARGET_HEX:002f" >/dev/null 2>&1 || true
            setpci -s "$PARENT_PORT" CAP_EXP+10.w=0020:0020 >/dev/null 2>&1 || true

            local retries=0
            while [ $retries -lt 30 ]; do
                local lnksta val
                lnksta=$(setpci -s "$PARENT_PORT" CAP_EXP+12.w 2>/dev/null || echo "0")
                val=$(( 16#${lnksta:-0} ))
                if [ $(( val & 0x0800 )) -eq 0 ] && [ $(( val & 0x2000 )) -ne 0 ]; then
                    break
                fi
                sleep 0.1
                retries=$((retries + 1))
            done
        fi

        sleep 0.5
        modprobe nvidia NVreg_DynamicPowerManagement=0x00 >/dev/null 2>&1 || true

        if [ -n "${PARENT_PORT:-}" ]; then
            setpci -s "$PARENT_PORT" CAP_EXP+30.w="$TARGET_HEX:002f" >/dev/null 2>&1 || true
        fi

        modprobe nvidia_modeset nvidia_drm nvidia_uvm >/dev/null 2>&1 || true
        udevadm settle || true

        nvidia-smi -pm 1 >/dev/null 2>&1 || true

        local MAX_GPU MAX_MEM
        MAX_GPU=$(nvidia-smi --query-gpu=clocks.max.graphics --format=csv,noheader,nounits 2>/dev/null | head -n 1 | tr -d '[:space:]' || echo "3090")
        MAX_MEM=$(nvidia-smi --query-gpu=clocks.max.memory --format=csv,noheader,nounits 2>/dev/null | head -n 1 | tr -d '[:space:]' || echo "14001")

        nvidia-smi --auto-boost-permission=0 >/dev/null 2>&1 || true
        nvidia-smi --lock-gpu-clocks="2000,${MAX_GPU:-3090}" >/dev/null 2>&1 || true
        nvidia-smi --lock-memory-clocks="${MAX_MEM:-14001},${MAX_MEM:-14001}" >/dev/null 2>&1 || true
    fi

    # Save exact GPU model name after module loading
    # Zapis dokładnej nazwy modelu karty po załadowaniu modułów
    local EGPU_MODEL
    EGPU_MODEL=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | xargs || true)
    if [ -n "$EGPU_MODEL" ]; then
        echo "$EGPU_MODEL" > "$EGPU2_FILE"
    fi

    # Save active PCIe link speed and generation to cache
    # Zapis aktualnego linku PCIe do cache
    local CURRENT_LINK
    CURRENT_LINK=$(lspci -d 10de: -vv 2>/dev/null | awk '/LnkSta:/ {for(i=1;i<=NF;i++) if($i ~ /Speed/) {
        speed=$(i+1);
        if (speed ~ /^32/) gen="Gen5";
        else if (speed ~ /^16/) gen="Gen4";
        else if (speed ~ /^8/) gen="Gen3";
        else if (speed ~ /^5/) gen="Gen2";
        else if (speed ~ /^2.5/) gen="Gen1";
        else gen="";

        if (gen != "") print speed " (" gen ")";
        else print speed;
    }}' | head -n1 || echo "N/A")
    echo "${CURRENT_LINK:-N/A}" > "$LINK_FILE"

    echo "3"
}

set4() {
    # Mode 4: eGPU-only mode (disconnect iGPU from PCI bus tree)
    # Mode 4: Tryb eGPU-only (odłączanie iGPU z drzewa PCI)

    # Mode 4: Save persistent eGPU-only flag and reset wait
    # Mode 4: Zapisanie trwałej flagi trybu eGPU-only
    echo "1" > "$EGPU_ONLY_FILE"
    echo "4" > "$STATE_FILE"
    echo "0" > "$WAIT_FILE"

    local found_igpu=0

    for dev in /sys/bus/pci/devices/*; do
        [ -d "$dev" ] || continue

        local vendor=""
        local class=""
        vendor=$(cat "$dev/vendor" 2>/dev/null || true)
        class=$(cat "$dev/class" 2>/dev/null || true)

        # Check for VGA/Display devices (class 0x03xxxx) for AMD (0x1002) and Intel (0x8086)
        # Sprawdzanie urządzeń VGA/Display (klasa 0x03xxxx) dla AMD (0x1002) oraz Intel (0x8086)
        if [[ "$class" =~ ^0x03 ]] && { [ "$vendor" = "0x1002" ] || [ "$vendor" = "0x8086" ]; }; then
            local addr=$(basename "$dev")

            # Pobierz i zapisz port nadrzędny (Parent Bridge) przed usunięciem
            local pci_tree parent_bridge
            pci_tree=$(lspci -D -PP -s "$addr" 2>/dev/null | awk '{print $1}' || true)
            parent_bridge=$(echo "$pci_tree" | awk -F'/' '{if (NF>1) print $(NF-1); else print $1}' || true)
            if [ -n "$parent_bridge" ]; then
                echo "$parent_bridge" > "$IGPU_PARENT_FILE"
            fi

            local base_slot="${addr%.*}"
            local audio_addr="${base_slot}.1"

            # 2. Zwolnij procesy trzymające I2C / DRM na kontrolerze iGPU
            fuser -k /dev/i2c-* >/dev/null 2>&1 || true
            fuser -k "/sys/bus/pci/devices/$addr" >/dev/null 2>&1 || true
            sleep 0.2
            # Powiadomienie DRM o zmianie konfiguracji i pauza na zwolnienie uchwytów
            udevadm trigger --subsystem-match=drm --action=change 2>/dev/null || true
            sleep 0.2

            # 3. Unbind sterownika graficznego (kluczowe zabezpieczenie przed stanem D-state)
            if [ -d "$dev/driver" ]; then
                echo "$addr" > "$dev/driver/unbind" 2>/dev/null || true
            fi
            sleep 0.1

            # Remove processor-integrated audio device
            # Odcięcie zintegrowanego audio powiązanego z procesorem
            if [ -d "/sys/bus/pci/devices/$audio_addr" ]; then
                echo 1 > "/sys/bus/pci/devices/$audio_addr/remove" 2>/dev/null || true
            fi

            # Remove iGPU display controller with safety guard
            # Odcięcie magistrali graficznej iGPU z asekuracją || true
            echo 1 > "/sys/bus/pci/devices/$addr/remove" 2>/dev/null || true
            found_igpu=1
        fi
    done

    udevadm settle --timeout=2 2>/dev/null || true

    echo "0" > "$WAIT_FILE"
    echo "4" > "$STATE_FILE"
    echo "4"
}

set5() {
    # Mode 5: Universal iGPU restore (AMD amdgpu / Intel i915 / Intel xe)
    rm -f "$EGPU_ONLY_FILE"

    # 1. Rescan celowany w mostek nadrzędny iGPU (oraz fallback na szynę główną)
    local parent_bridge=""
    if [ -f "$IGPU_PARENT_FILE" ]; then
        parent_bridge=$(cat "$IGPU_PARENT_FILE" 2>/dev/null || true)
    fi

    if [ -n "${parent_bridge:-}" ] && [ -f "/sys/bus/pci/devices/$parent_bridge/rescan" ]; then
        echo 1 > "/sys/bus/pci/devices/$parent_bridge/rescan" 2>/dev/null || true
    else
        echo 1 > /sys/bus/pci/rescan 2>/dev/null || true
    fi

    rm -f "$IGPU_PARENT_FILE"

    # 2. Synchronizacja udev i wyzwolenie zdarzeń DRM dla kompozytora
    udevadm settle --timeout=3 2>/dev/null || true
    udevadm trigger --subsystem-match=drm --action=change 2>/dev/null || true
    udevadm settle --timeout=2 2>/dev/null || true

    echo "0" > "$WAIT_FILE"
    echo "5" > "$STATE_FILE"
    echo "5"
}

set6() {
    # Mode 6: Safe eGPU Detach without killing Wayland session compositor
    # Mode 6: Bezpieczne odpięcie eGPU bez ubijania kompozytora Wayland

    # 1. Clear persistent flags first
    rm -f "$EGPU_ONLY_FILE" "$LINK_FILE" "$EGPU2_FILE" "$TRAFFIC_CACHE"

    # 2. Verify iGPU presence before dropping eGPU
    local igpu_present
    igpu_present=$(lspci -nn 2>/dev/null | grep -iE "VGA|3D" | grep -iE "1002:|8086:" | head -n1 || true)
    if [ -z "$igpu_present" ]; then
        echo 1 > /sys/bus/pci/rescan 2>/dev/null || true
        udevadm settle --timeout=2 2>/dev/null || true
    fi

    # 3. Trigger DRM change event
    udevadm trigger --subsystem-match=drm --action=change 2>/dev/null || true
    udevadm settle --timeout=1 2>/dev/null || true

    # 4. Safely remove NVIDIA PCIe device functions
    local GPU_FULL_PCI
    GPU_FULL_PCI=$(lspci -D -d 10de: -nn 2>/dev/null | grep -iE "VGA|3D" | awk '{print $1}' | head -n 1 || true)
    if [ -n "${GPU_FULL_PCI:-}" ]; then
        local GPU_SLOT="${GPU_FULL_PCI%.*}"
        for dev in "/sys/bus/pci/devices/${GPU_SLOT}".*; do
            if [ -d "$dev" ] && [ -w "$dev/remove" ]; then
                echo 1 > "$dev/remove" 2>/dev/null || true
            fi
        done
    fi

    # 5. Settle udev queue
    udevadm settle --timeout=2 2>/dev/null || true

    # 6. Softly unload NVIDIA modules
    modprobe -r nvidia_uvm nvidia_drm nvidia_modeset nvidia >/dev/null 2>&1 || true

    # 7. Reset wait state
    echo "0" > "$WAIT_FILE"

    # Clean single-digit return value
    echo "2"
}

# ==============================================================================
# 6. SET COMMAND HANDLER (Cascading step-up execution with wait flag)
# 6. OBSŁUGA POLECENIA SET (Kaskadowe przejście w górę z flagą wait)
# ==============================================================================
if [ "$ACTION" = "set" ]; then
    if [[ ! "$TARGET_MODE" =~ ^[2-6]$ ]]; then
        exit 0
    fi

    CURRENT=$(cat "$STATE_FILE" 2>/dev/null || echo "1")

    # Direct jump: from Mode 3 straight to Safe Detach (Mode 6) without triggering 4/5
    if [ "$TARGET_MODE" = "6" ]; then
        if [ "$CURRENT" = "3" ]; then
            echo "1" > "$WAIT_FILE"
            trap 'echo "0" > "$WAIT_FILE"' EXIT INT TERM
            RESULT=$(set6 | tail -n1 | tr -dc '0-9')
            echo "${RESULT:-2}" > "$STATE_FILE"
            exit 0
        fi
        exit 0
    fi

    if [ "$CURRENT" -lt "$TARGET_MODE" ]; then
        echo "1" > "$WAIT_FILE"
        trap 'echo "0" > "$WAIT_FILE"' EXIT INT TERM

        NEXT=$((CURRENT + 1))
        for step in $(seq "$NEXT" "$TARGET_MODE"); do
            case "$step" in
                2) RESULT=$(set2) ;;
                3) RESULT=$(set3) ;;
                4) RESULT=$(set4) ;;
                5) RESULT=$(set5) ;;
            esac
            echo "$RESULT" > "$STATE_FILE"
        done
    fi

    exit 0
fi
